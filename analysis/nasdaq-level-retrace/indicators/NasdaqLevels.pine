//@version=5
// Nasdaq daily and weekly open/close levels, and the order plan for one of the three profitable runs.
//
// Levels are the open and the close of every completed CME candle, 17:00 to 16:00 America/Chicago.
// A candle counts only when its first bar is at or after 17:00 Chicago on the session date.
// The week starts on that session's Sunday. A level is tradable from the bar after the candle closes.
// Lookback is 30, 182, or 365 days from the candle close, or no expiry. Same windows as the study.
// Prices are rounded to 0.01. Weekly is yellow, daily is blue. An open is solid. A close-only level is dashed.
//
// Fade 50/50: a cross up sells and a cross down buys. London 08:00–16:30 or New York 08:00–17:00.
// Continuation: a cross up buys and a cross down sells. New York RTH 09:30–16:00.
// The dashboard lists both orders because the cross can go either way. The fill shown is the level.
// A gap through the level fills at the open. A 1-minute chart matches the study.

indicator("Nasdaq level book", "Levels", overlay=true, max_lines_count=500, max_labels_count=500)

const string gS = "Strategy"
const string gL = "Levels"
const string gD = "Dashboard"

strat = input.string("Continuation 100/150", "Run", options=["Fade 50/50", "Continuation 100/50", "Continuation 100/150"], group=gS, tooltip="Fade is sl50 tp50, all sessions, one at a time. Both continuation runs are sl100, New York RTH, every level. All three take one trade per New York day.")
pointSize = input.float(1.0, "Index point", minval=0.0000001, step=0.01, group=gS, tooltip="Stop and target distances are multiplied by this. Use 1 on NAS100, so a 50-point stop is 50.00 in price.")
lookPick = input.string("1 month", "Lookback", options=["1 month", "6 months", "1 year", "All"], group=gL, tooltip="1 month is 30 days, 6 months is 182 days, 1 year is 365 days, counted from the candle close. All keeps every completed level.")
showDaily = input.bool(true, "Daily opens and closes", group=gL)
showWeekly = input.bool(true, "Weekly opens and closes", group=gL)
maxLines = input.int(80, "Max lines, nearest to price", minval=1, maxval=500, group=gL)
sideN = input.int(3, "Levels each side in the dashboard", minval=1, maxval=6, group=gD)
showLabels = input.bool(true, "Label the dashboard levels", group=gD)

bool isFade = strat == "Fade 50/50"
float slPts = isFade ? 50.0 : 100.0
float tpPts = strat == "Continuation 100/150" ? 150.0 : 50.0
float slPx = slPts * pointSize
float tpPx = tpPts * pointSize
int lookDays = lookPick == "1 month" ? 30 : lookPick == "6 months" ? 182 : lookPick == "1 year" ? 365 : 0
int upSide = isFade ? -1 : 1
int dnSide = -upSide
string runId = isFade ? "sl50 tp50 fade" : strat == "Continuation 100/50" ? "sl100 tp50 continuation" : "sl100 tp150 continuation"
string lotTxt = isFade ? "0.10 lot" : "0.05 lot"
string sessName = isFade ? "London or New York" : "New York RTH"
string ruleTxt = isFade ? "Cross up sells. Cross down buys. One at a time." : "Cross up buys. Cross down sells. Every level."
color upCol = upSide == 1 ? #1b7f3a : #8a2b2b
color dnCol = dnSide == 1 ? #1b7f3a : #8a2b2b
int tableRows = 40

f_pad(int v) =>
    v < 10 ? "0" + str.tostring(v) : str.tostring(v)

f_date(int ymd) =>
    str.tostring(int(ymd / 10000)) + "-" + f_pad(int((ymd / 100) % 100)) + "-" + f_pad(ymd % 100)

f_px(float p) =>
    str.tostring(p, "0.00")

f_prev_ymd(int y, int m, int d) =>
    int noon = timestamp("America/Chicago", y, m, d, 12, 0) - 86400000
    year(noon, "America/Chicago") * 10000 + month(noon, "America/Chicago") * 100 + dayofmonth(noon, "America/Chicago")

f_shift_ymd(int ymd, int back) =>
    int y = int(ymd / 10000)
    int m = int((ymd / 100) % 100)
    int d = ymd % 100
    int noon = timestamp("America/Chicago", y, m, d, 12, 0) - back * 86400000
    year(noon, "America/Chicago") * 10000 + month(noon, "America/Chicago") * 100 + dayofmonth(noon, "America/Chicago")

f_order(float level, int side) =>
    float stop = level - side * slPx
    float tgt = level + side * tpPx
    (side == 1 ? "Buy" : "Sell") + " stop " + f_px(stop) + "  tgt " + f_px(tgt)

// Returns the updated candle plus, when a candle just finished, its open, close, close time, and end date.
f_step(bool inC, int key, int barYmd, int mins, int barTime, float barOpen, float barClose, bool wasBuild, int curKey, float op, float cl, bool st, int lastT, int savedYmd) =>
    bool build = wasBuild
    int k = curKey
    float op2 = op
    float cl2 = cl
    bool st2 = st
    int last2 = lastT
    int saved2 = savedYmd
    bool emit = false
    float eOpen = na
    float eClose = na
    int eTs = 0
    int eLab = 0
    if inC
        if not build or key != k
            if build and st
                emit := true
                eOpen := op
                eClose := cl
                eTs := lastT
                eLab := savedYmd
            build := true
            k := key
            op2 := barOpen
            cl2 := barClose
            st2 := barYmd == key and mins >= 17 * 60
            last2 := barTime
            saved2 := barYmd
        else
            cl2 := barClose
            last2 := barTime
            saved2 := barYmd
    else if build
        if st
            emit := true
            eOpen := op
            eClose := cl
            eTs := lastT
            eLab := savedYmd
        build := false
    [build, k, op2, cl2, st2, last2, saved2, emit, eOpen, eClose, eTs, eLab]

type Lv
    float price
    int bits
    int ready
    int expire
    string src1
    string src2
    int nsrc

var bool dBuild = false
var int dKey = 0
var float dOpen = na
var float dClose = na
var bool dStarted = false
var int dLast = 0
var int dSaved = 0
var bool wBuild = false
var int wKey = 0
var float wOpen = na
var float wClose = na
var bool wStarted = false
var int wLast = 0
var int wSaved = 0
var array<Lv> raw = array.new<Lv>()
var map<int, int> at = map.new<int, int>()
var array<line> lines = array.new<line>()
var array<label> labs = array.new<label>()
var table dash = na

f_src(Lv item) =>
    string src = item.src1
    if item.src2 != ""
        src += " · " + item.src2
    if item.nsrc > 2
        src += " +" + str.tostring(item.nsrc - 2)
    src

f_put(int r, string a, string b, string c, color ca, color cb, color cc) =>
    if r < tableRows
        table.cell(dash, 0, r, a, text_color=ca, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 1, r, b, text_color=cb, text_size=size.small, text_halign=text.align_left)
        table.cell(dash, 2, r, c, text_color=cc, text_size=size.small, text_halign=text.align_left)

f_section(array<int> ids, string title, int rr) =>
    int r2 = rr
    if r2 < tableRows
        f_put(r2, title, "", "", #5c564c, #5c564c, #5c564c)
        table.merge_cells(dash, 0, r2, 2, r2)
        r2 += 1
    int n = array.size(ids)
    if n == 0
        if r2 < tableRows
            f_put(r2, "none", "", "", #5c564c, #5c564c, #5c564c)
            table.merge_cells(dash, 0, r2, 2, r2)
            r2 += 1
    else
        for k = 0 to n - 1
            if r2 < tableRows
                Lv item = array.get(raw, array.get(ids, k))
                f_put(r2, f_px(item.price) + "   " + f_src(item), f_order(item.price, upSide), f_order(item.price, dnSide), #1c1a17, upCol, dnCol)
                r2 += 1
    r2

f_insert(array<int> ids, array<float> dists, int idx, float dist, int cap) =>
    int n = array.size(ids)
    int pos = n
    if n > 0
        for i = 0 to n - 1
            if dist < array.get(dists, i)
                pos := i
                break
    if pos < cap
        array.insert(ids, pos, idx)
        array.insert(dists, pos, dist)
        if array.size(ids) > cap
            array.pop(ids)
            array.pop(dists)

f_bit(int bits, int flag) =>
    int(math.floor(bits / flag)) % 2 == 1

f_with(int bits, int flag) =>
    f_bit(bits, flag) ? bits : bits + flag

f_daily(int bits) =>
    f_bit(bits, 1) or f_bit(bits, 2)

f_weekly(int bits) =>
    f_bit(bits, 4) or f_bit(bits, 8)

f_open(int bits) =>
    f_bit(bits, 1) or f_bit(bits, 4)

f_push(float px, int bit, int closeTs, int labelYmd, string kindName) =>
    float rounded = math.round(px * 100.0) / 100.0
    int cents = int(math.round(rounded * 100.0))
    int exp = lookDays == 0 ? 0 : closeTs + lookDays * 86400000
    string piece = kindName + " " + f_date(labelYmd)
    if map.contains(at, cents)
        int idx = map.get(at, cents)
        Lv item = array.get(raw, idx)
        bool live = item.expire == 0 or time < item.expire
        if not live
            array.set(raw, idx, Lv.new(rounded, bit, time, exp, piece, "", 1))
        else
            int mergedExpire = item.expire
            if lookDays == 0 or item.expire == 0 or exp == 0
                mergedExpire := 0
            else
                mergedExpire := math.max(item.expire, exp)
            array.set(raw, idx, Lv.new(rounded, f_with(item.bits, bit), math.min(item.ready, time), mergedExpire, piece, item.src1, item.nsrc + 1))
    else
        map.put(at, cents, array.size(raw))
        array.push(raw, Lv.new(rounded, bit, time, exp, piece, "", 1))

int ctMins = hour(time, "America/Chicago") * 60 + minute(time, "America/Chicago")
int ctY = year(time, "America/Chicago")
int ctM = month(time, "America/Chicago")
int ctD = dayofmonth(time, "America/Chicago")
int ctYmd = ctY * 10000 + ctM * 100 + ctD
bool inCandle = ctMins >= 17 * 60 or ctMins < 16 * 60
int openYmd = ctMins < 16 * 60 ? f_prev_ymd(ctY, ctM, ctD) : ctYmd
int openNoon = timestamp("America/Chicago", int(openYmd / 10000), int((openYmd / 100) % 100), openYmd % 100, 12, 0)
int monday0 = (dayofweek(openNoon, "America/Chicago") + 5) % 7
int weekYmd = f_shift_ymd(openYmd, (monday0 + 1) % 7)

[dBuild2, dKey2, dOpen2, dClose2, dStarted2, dLast2, dSaved2, dEmit, dEOpen, dEClose, dETs, dELab] = f_step(inCandle, openYmd, ctYmd, ctMins, time, open, close, dBuild, dKey, dOpen, dClose, dStarted, dLast, dSaved)
dBuild := dBuild2
dKey := dKey2
dOpen := dOpen2
dClose := dClose2
dStarted := dStarted2
dLast := dLast2
dSaved := dSaved2

[wBuild2, wKey2, wOpen2, wClose2, wStarted2, wLast2, wSaved2, wEmit, wEOpen, wEClose, wETs, wELab] = f_step(inCandle, weekYmd, ctYmd, ctMins, time, open, close, wBuild, wKey, wOpen, wClose, wStarted, wLast, wSaved)
wBuild := wBuild2
wKey := wKey2
wOpen := wOpen2
wClose := wClose2
wStarted := wStarted2
wLast := wLast2
wSaved := wSaved2

if dEmit and showDaily
    f_push(dEOpen, 1, dETs, dELab, "D open")
    f_push(dEClose, 2, dETs, dELab, "D close")
if wEmit and showWeekly
    f_push(wEOpen, 4, wETs, wELab, "W open")
    f_push(wEClose, 8, wETs, wELab, "W close")

if barstate.islast
    if not na(dash)
        table.delete(dash)
    dash := table.new(position.top_right, 3, tableRows, bgcolor=color.new(#f4f1ea, 4), border_color=#e6d3b0, border_width=1, frame_color=#e6d3b0, frame_width=1)
    while array.size(lines) > 0
        line.delete(array.pop(lines))
    while array.size(labs) > 0
        label.delete(array.pop(labs))

    array<int> active = array.new<int>()
    int nRaw = array.size(raw)
    if nRaw > 0
        for i = 0 to nRaw - 1
            Lv item = array.get(raw, i)
            bool alive = time >= item.ready and (item.expire == 0 or time < item.expire)
            bool dailyOn = f_daily(item.bits) and showDaily
            bool weeklyOn = f_weekly(item.bits) and showWeekly
            if alive and (dailyOn or weeklyOn)
                array.push(active, i)

    array<int> near = array.new<int>()
    array<float> nearDist = array.new<float>()
    array<int> above = array.new<int>()
    array<float> aboveDist = array.new<float>()
    array<int> below = array.new<int>()
    array<float> belowDist = array.new<float>()
    array<int> atPx = array.new<int>()
    int nAct = array.size(active)
    if nAct > 0
        for k = 0 to nAct - 1
            int idx = array.get(active, k)
            Lv item = array.get(raw, idx)
            float dist = math.abs(item.price - close)
            f_insert(near, nearDist, idx, dist, maxLines)
            if dist <= 0.001
                if array.size(atPx) < sideN
                    array.push(atPx, idx)
            else if item.price > close
                f_insert(above, aboveDist, idx, dist, sideN)
            else
                f_insert(below, belowDist, idx, dist, sideN)

    int nNear = array.size(near)
    if nNear > 0
        for k = 0 to nNear - 1
            Lv item = array.get(raw, array.get(near, k))
            bool weekly = f_weekly(item.bits)
            color col = weekly ? color.yellow : #2962ff
            if f_open(item.bits)
                array.push(lines, line.new(item.ready, item.price, time, item.price, xloc=xloc.bar_time, extend=extend.right, color=col, style=line.style_solid, width=1))
            else
                array.push(lines, line.new(item.ready, item.price, time, item.price, xloc=xloc.bar_time, extend=extend.right, color=col, style=line.style_dashed, width=1))

    if showLabels
        array<int> tagged = array.new<int>()
        int nAt = array.size(atPx)
        int nAbove = array.size(above)
        int nBelow = array.size(below)
        if nAt > 0
            for k = 0 to nAt - 1
                array.push(tagged, array.get(atPx, k))
        if nAbove > 0
            for k = 0 to nAbove - 1
                array.push(tagged, array.get(above, k))
        if nBelow > 0
            for k = 0 to nBelow - 1
                array.push(tagged, array.get(below, k))
        int nTag = array.size(tagged)
        if nTag > 0
            for k = 0 to nTag - 1
                Lv item = array.get(raw, array.get(tagged, k))
                bool weekly = f_weekly(item.bits)
                color col = weekly ? color.yellow : #2962ff
                array.push(labs, label.new(time, item.price, f_px(item.price) + "  " + f_src(item), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(col, 85), textcolor=#1c1a17, size=size.small))

    int nyM = hour(time, "America/New_York") * 60 + minute(time, "America/New_York")
    int lonM = hour(time, "Europe/London") * 60 + minute(time, "Europe/London")
    bool inNy = nyM >= 8 * 60 and nyM < 17 * 60
    bool inRth = nyM >= 9 * 60 + 30 and nyM < 16 * 60
    bool inLon = lonM >= 8 * 60 and lonM < 16 * 60 + 30
    bool inSess = isFade ? (inLon or inNy) : inRth

    int r = 0
    f_put(r, strat + "  ·  " + lotTxt, "", "", #1c1a17, #1c1a17, #1c1a17)
    table.merge_cells(dash, 0, r, 2, r)
    r += 1
    f_put(r, lookPick + "  ·  " + str.tostring(nAct) + " levels  ·  " + sessName + "  ·  " + (inSess ? "in session" : "outside session"), "", "", #1c1a17, #1c1a17, #1c1a17)
    table.merge_cells(dash, 0, r, 2, r)
    r += 1
    f_put(r, ruleTxt + " One trade per New York day.", "", "", #1c1a17, #1c1a17, #1c1a17)
    table.merge_cells(dash, 0, r, 2, r)
    r += 1
    f_put(r, "Stop " + f_px(slPts) + "   target " + f_px(tpPts) + "   fill at the level", "", "", #5c564c, #5c564c, #5c564c)
    table.merge_cells(dash, 0, r, 2, r)
    r += 1
    f_put(r, "Level", "Cross up", "Cross down", #5c564c, upCol, dnCol)
    r += 1

    if array.size(atPx) > 0
        r := f_section(atPx, "At price", r)
    r := f_section(above, "Above", r)
    r := f_section(below, "Below", r)
    if r < tableRows
        f_put(r, "Blue daily, yellow weekly. Solid open, dashed close. " + runId, "", "", #5c564c, #5c564c, #5c564c)
        table.merge_cells(dash, 0, r, 2, r)
